# Copy this file to .env and fill in local credentials.
# Never commit .env.
ENABLED_PROVIDERS=atgpay,millerpay,penguinpay

ATGPAY_PHONE=
ATGPAY_PASSWORD=

# Confirmed defaults for the observed ATG Pay order pool.
ATGPAY_API_BASE=https://api.atg-game.com/app
ATGPAY_SORT_TYPE=1
ATGPAY_ORDER_TYPE=4
ATGPAY_PAGE_SIZE=10
ATGPAY_REQUEST_DELAY_MS=150
ATGPAY_TIMEOUT_SECONDS=30

MILLERPAY_PHONE=
MILLERPAY_PASSWORD=
MILLERPAY_API_BASE=https://api.millerpay-app.com/app
MILLERPAY_SORT_TYPE=1
MILLERPAY_ORDER_TYPE=1
MILLERPAY_PAGE_SIZE=10
MILLERPAY_REQUEST_DELAY_MS=150
MILLERPAY_TIMEOUT_SECONDS=30

PENGUINPAY_PHONE=
PENGUINPAY_PASSWORD=
PENGUINPAY_API_BASE=https://api.penguinpay-app.com/app
PENGUINPAY_SORT_TYPE=1
PENGUINPAY_ORDER_TYPE=1
PENGUINPAY_PAGE_SIZE=10
PENGUINPAY_REQUEST_DELAY_MS=150
PENGUINPAY_TIMEOUT_SECONDS=30

# Optional standalone collector: python3 scripts/hoyopay_readonly.py
# HOYO PAY is not registered in ENABLED_PROVIDERS.
HOYOPAY_PHONE=
HOYOPAY_PASSWORD=

REPORT_DIRECTORY=reports
