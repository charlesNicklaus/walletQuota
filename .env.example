# Copy this file to .env and fill in local ATG Pay credentials.
# Never commit .env.
ATG_PHONE=
ATG_PASSWORD=

# Confirmed defaults for the observed order pool.
ATG_API_BASE=https://api.atg-game.com/app
ATG_SORT_TYPE=1
ATG_ORDER_TYPE=4
ATG_PAGE_SIZE=10
ATG_REQUEST_DELAY_MS=150
ATG_TIMEOUT_SECONDS=30
ATG_REPORT_DIRECTORY=reports
