# Copy this file to .env and fill in local credentials.
# Never commit .env.
ENABLED_PROVIDERS=atgpay

ATGPAY_PHONE=
ATGPAY_PASSWORD=

# Confirmed defaults for the observed ATG Pay order pool.
ATGPAY_API_BASE=https://api.atg-game.com/app
ATGPAY_SORT_TYPE=1
ATGPAY_ORDER_TYPE=4
ATGPAY_PAGE_SIZE=10
ATGPAY_REQUEST_DELAY_MS=150
ATGPAY_TIMEOUT_SECONDS=30

REPORT_DIRECTORY=reports
